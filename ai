-- Global attach loop for fling
local attachLoopActive = false
local attachLoopThread = nil

local function startAttachLoop(targetPlayer, mode)
    if attachLoopThread then task.cancel(attachLoopThread) end
    attachLoopActive = true

    attachLoopThread = task.spawn(function()
        while attachLoopActive do
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then break end

            local target = getTargetPlayer(savedTargetName)
            if not target or not target.Character then
                task.wait(0.5)
                continue
            end

            local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
            local targetHead = target.Character:FindFirstChild("Head")
            if not targetHRP or not targetHead then
                task.wait(0.5)
                continue
            end

            -- Zero delay physics
            if ZeroDelay.Enabled or T.NoDelay then
                pcall(function()
                    if typeof(sethiddenproperty) == "function" then
                        sethiddenproperty(LocalPlayer, "SimulationRadius", ZeroDelay.SimulationRadius)
                        sethiddenproperty(LocalPlayer, "MaxSimulationRadius", ZeroDelay.SimulationRadius)
                        settings().Physics.AllowSleep = false
                        sethiddenproperty(hrp, "PhysicsRepRootPart", targetHRP)
                    end
                end)
            end

            -- Position based on mode
            if mode == "inside" then
                hrp.CFrame = targetHead.CFrame + Vector3.new(0, 0.5, 0)
            elseif mode == "head" then
                hrp.CFrame = targetHead.CFrame + Vector3.new(0, 3.0, 0)
            elseif mode == "gaze" then
                hrp.CFrame = targetHead.CFrame * GAZE_WELD_OFFSET
            end

            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero

            -- Fling effect
            pcall(function()
                targetHRP.AssemblyLinearVelocity = Vector3.new(0, 9e7, 0)
                targetHRP.AssemblyAngularVelocity = Vector3.new(9e7, 9e7, 9e7)
                targetHRP.Velocity = Vector3.new(0, 9e7, 0)
                targetHRP.RotVelocity = Vector3.new(9e7, 9e7, 9e7)
            end)

            RenderStepped:Wait()
        end
        attachLoopActive = false
    end)
end

local function stopAttachLoop()
    attachLoopActive = false
    if attachLoopThread then
        task.cancel(attachLoopThread)
        attachLoopThread = nil
    end
end

local function startBang(targetName, speed, mode, isResume)
    stopBangs()
    stopAttachLoop()
    if not isResume then
        savedTargetName = targetName
        savedSpeed = speed
        savedMode = mode
    end

    local target = getTargetPlayer(targetName)
    if not target or not target.Character then
        warn("[AMEN FLING] Target not found!")
        return
    end
    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end

    local myHRP = waitForHRP(LocalPlayer.Character, 5)
    if not myHRP then return end

    applyZeroDelayPhysics()

    local targetHead = target.Character:FindFirstChild("Head")
    local waited = 0
    while not targetHead and waited < 5 do
        task.wait(0.1)
        waited = waited + 0.1
        targetHead = target.Character:FindFirstChild("Head")
    end

    if targetHead then
        if mode == "head" then
            myHRP.CFrame = targetHead.CFrame + Vector3.new(0, 3.0, 0)
        elseif mode == "gaze" then
            myHRP.CFrame = targetHead.CFrame * GAZE_WELD_OFFSET
        else
            myHRP.CFrame = targetHead.CFrame + Vector3.new(0, 0.5, 0)
        end
    else
        myHRP.CFrame = targetHRP.CFrame + Vector3.new(0, 3.0, 0)
    end

    disconnectTargetListeners()

    targetCharacterConn = target.CharacterAdded:Connect(function(newChar)
        if not (frontBangOn or headBangOn or gazeFaceBangOn) then return end
        task.wait(1)
        if not (frontBangOn or headBangOn or gazeFaceBangOn) then return end
        local newHRP = waitForHRP(newChar, 8)
        if newHRP then
            startBang(savedTargetName, savedSpeed, savedMode, true)
        end
    end)

    targetRemovingConn = target.AncestryChanged:Connect(function()
        if not target:IsDescendantOf(game) and (frontBangOn or headBangOn or gazeFaceBangOn) then
            stopBangs()
            stopAttachLoop()
            resetAllButtons()
            savedTargetName = nil
            disconnectTargetListeners()
            stopEmote()
        end
    end)

    startAttachLoop(target, mode)

    if mode == "head" then
        playEmote()
    elseif mode == "gaze" then
        startGazeLoop()
    end
end

