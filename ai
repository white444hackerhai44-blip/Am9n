    sub.Position = UDim2.new(0, 14, 0, 28)
    sub.Text = tooltipText or ""
    sub.Font = Enum.Font.Gotham
    sub.TextSize = 10
    sub.TextColor3 = tbl3.textMuted
    sub.TextXAlignment = Enum.TextXAlignment.Left
    sub.BackgroundTransparency = 1

    local fmt = "%." .. (decimals or 1) .. "f"
    local valLbl = Instance.new("TextLabel", frame)
    valLbl.Size = UDim2.new(0, 48, 0, 18)
    valLbl.Position = UDim2.new(1, -58, 0, 8)
    valLbl.Text = string.format(fmt, default)
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 11
    valLbl.TextColor3 = tbl3.accent
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.BackgroundTransparency = 1

    local track = Instance.new("Frame", frame)
    track.Size = UDim2.new(0, 100, 0, 6)
    track.Position = UDim2.new(1, -118, 0, 32)
    track.BackgroundColor3 = Color3.fromRGB(15,15,15)
    track.BackgroundTransparency = 0.5
    track.BorderSizePixel = 0
    corner(track, 999)
    local tstroke = Instance.new("UIStroke", track)
    tstroke.Color = Color3.fromRGB(255,255,255)
    tstroke.Thickness = 1
    tstroke.Transparency = 0.85

    local fill = Instance.new("Frame", track)
    local pct = (default - min) / (max - min)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = tbl3.accent
    fill.BorderSizePixel = 0
    corner(fill, 999)

    local knob2 = Instance.new("Frame", fill)
    knob2.Size = UDim2.new(0, 14, 0, 14)
    knob2.Position = UDim2.new(1, -7, 0.5, -7)
    knob2.BackgroundColor3 = tbl3.toggleKnob
    knob2.BorderSizePixel = 0
    corner(knob2, 999)
    local kg = Instance.new("UIGradient", knob2)
    kg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(150,150,150)),
    })
    kg.Rotation = 90
    local ks = Instance.new("UIStroke", knob2)
    ks.Color = Color3.fromRGB(255,255,255)
    ks.Thickness = 1
    ks.Transparency = 0.5

    local dragBtn = Instance.new("TextButton", track)
    dragBtn.Size = UDim2.new(1, 0, 1, 20)
    dragBtn.Position = UDim2.new(0, 0, 0.5, -10)
    dragBtn.BackgroundTransparency = 1
    dragBtn.Text = ""

    local dragging2 = false

    local function update(input)
        local p = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        fill.Size = UDim2.new(p, 0, 1, 0)
        local v = min + (max - min) * p
        v = math.floor(v * (10^decimals) + 0.5) / (10^decimals)
        valLbl.Text = string.format(fmt, v)
        if callback then callback(v) end
    end

    dragBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging2 = true
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging2 = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging2 and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)

    return frame
end

