local dragging_delay = false
local function set_delay_from_x(abs_x)
    local rel = math.clamp((abs_x - delay_track.AbsolutePosition.X) / delay_track.AbsoluteSize.X, 0, 1)
    local v = DELAY_MAX - (DELAY_MAX - DELAY_MIN) * rel
    v = math.floor(v * 100 + 0.5) / 100
    CHAT_DELAY = v
    delay_fill.Size = UDim2.new(rel, 0, 1, 0)
    delay_dot.Position = UDim2.new(rel, 0, 0.5, 0)
    delay_label.Text = string.format("delay: %.2fs", v)
end
delay_hit.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging_delay = true
        set_delay_from_x(input.Position.X)
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging_delay
    and (input.UserInputType == Enum.UserInputType.MouseMovement
      or input.UserInputType == Enum.UserInputType.Touch) then
        set_delay_from_x(input.Position.X)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging_delay = false
    end
end)

