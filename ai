-- PHYSICAL WELD ENGINE
-- ==========================================================
CurrentWeld   = nil
WeldOffset    = CFrame.new(0, 0, 0)
WeldVelocity  = Vector3.new(0, 0, 0)
WeldAnimID    = 33379663
WeldSpeedDelay= 0.005

local function changeWeldOffset(cfr) WeldOffset = cfr end
local function changeWeldVelocity(v) WeldVelocity = v end
local function changeWeldAnim(n)
    WeldAnimID = n
    if CurrentWeld and CurrentWeld.UpdateAnim then CurrentWeld.UpdateAnim() end
end
local function setWeldSpeed(speedVal)
    speedVal = math.clamp(tonumber(speedVal) or 10000, 1, 10000)
    WeldSpeedDelay = math.max(0.001, 0.05 * (100 / speedVal))
end

local WELD_GROUP = "AmenFlingGroup_" .. tostring(math.random(100000, 999999))
pcall(function()
    PhysicsService:RegisterCollisionGroup(WELD_GROUP)
    PhysicsService:CollisionGroupSetCollidable(WELD_GROUP, WELD_GROUP, true)
end)

fastRotateOn = false
rotateSpeed = 500
rotateAngle = 0
lastWeldRefresh = 0

function PhysicalWeldTo(Part, headMode, offsetY)
    if not Part or not Part.Parent then return end
    local targetPlr = Players:GetPlayerFromCharacter(Part.Parent)
    if targetPlr then
        local H = Part.Parent:FindFirstChildWhichIsA("Humanoid")
        if H then H.RequiresNeck = false end
    end

    local Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return nil end
    local Root = Character.HumanoidRootPart.AssemblyRootPart
    local Start = CFrame.new(Root.Position)

    local pivotPart = Part
    if headMode then
        local head = Part.Parent and Part.Parent:FindFirstChild("Head")
        if head then
            pivotPart = head
        else
            for _ = 1, 50 do
                task.wait(0.1)
                head = Part.Parent and Part.Parent:FindFirstChild("Head")
                if head then pivotPart = head break end
            end
        end
    end

    local Weld        = {}
    local Enabled     = false
    local PartJoints  = {}
    local OldProps    = {}
    local OldCharProps= {}
    Weld.Part = pivotPart

    local AnimTrack = nil
    if WeldAnimID and WeldAnimID ~= 0 then
        local Animator = Character:FindFirstChildWhichIsA("Animator", true)
        if Animator then
            local Animation = Instance.new("Animation")
            Animation.AnimationId = "rbxassetid://" .. tostring(WeldAnimID)
            AnimTrack = Animator:LoadAnimation(Animation)
            AnimTrack.Priority = Enum.AnimationPriority.Action
            AnimTrack.Looped = true
            AnimTrack:Play()
        end
    end

    function Weld:Enable(toggle)
        Enabled = toggle
        if not toggle then
            for _, Joint in next, PartJoints do
                if Joint then Joint.Enabled = true end
            end
            for PropName, Value in next, OldProps do
                pcall(function() pivotPart[PropName] = Value end)
            end
            for part, props in next, OldCharProps do
                if not part or not part.Parent then continue end
                pcall(function()
                    part.CollisionGroup = props.Group
                    part.CanCollide     = props.Collide
                end)
            end
            return
        end

        PartJoints = pivotPart:GetJoints()
        for _, PropName in next, {"Size","CanCollide","Anchored","Parent","CollisionGroup"} do
            OldProps[PropName] = pivotPart[PropName]
        end
        for _, p in next, Character:GetDescendants() do
            if not p:IsA("BasePart") then continue end
            OldCharProps[p] = { Group = p.CollisionGroup, Collide = p.CanCollide }
            p.CollisionGroup = WELD_GROUP
            p.CanCollide     = true
        end

        pivotPart.Size = Vector3.new(25, 3, 25)
        pivotPart.Anchored = false
        pivotPart.CanCollide = true
        pivotPart.CollisionGroup = WELD_GROUP
        pivotPart.Parent = workspace.Terrain
        for _, Joint in next, PartJoints do
            if Joint then Joint.Enabled = false end
        end
    end

    function Weld.UpdateAnim()
        local Animator = Character:FindFirstChildWhichIsA("Animator", true)
        if Animator then
            if AnimTrack then AnimTrack:Stop(); AnimTrack:Destroy() end
            local Animation = Instance.new("Animation")
            Animation.AnimationId = "rbxassetid://" .. tostring(WeldAnimID)
            AnimTrack = Animator:LoadAnimation(Animation)
            AnimTrack.Priority = Enum.AnimationPriority.Action
            AnimTrack.Looped = true
            AnimTrack:Play()
        end
    end

    local thread = nil
    function Weld:Destroy()
        if thread then task.cancel(thread) end
        Weld:Enable(false)
        if AnimTrack then AnimTrack:Stop(); AnimTrack:Destroy() end
    end

    local yOffset = offsetY or 3.0
    local headOffset = CFrame.new(0, yOffset, 0)
    local loopCount = 0

    thread = task.spawn(function()
        while task.wait(WeldSpeedDelay) do
            if not Enabled then continue end
            if not pivotPart or not pivotPart.Parent then break end
            loopCount = loopCount + 1

            if fastRotateOn then
                local spd = rotateSpeed * 6
                rotateAngle = rotateAngle + math.rad(spd * WeldSpeedDelay)
                if rotateAngle > math.pi * 2 then
                    rotateAngle = rotateAngle - math.pi * 2
                end
            end
            local rotateCF = fastRotateOn
                and CFrame.Angles(rotateAngle, rotateAngle * 1.3, rotateAngle * 0.7)
                or CFrame.new()

            if loopCount % 50 == 0 then
                pcall(function()
                    if pivotPart and pivotPart.Parent ~= workspace.Terrain then
                        pivotPart.Parent = workspace.Terrain
                    end
                    if pivotPart then
                        pivotPart.CanCollide = true
                        pivotPart.Anchored = false
                        pivotPart.CollisionGroup = WELD_GROUP
                        pivotPart.Size = Vector3.new(25, 3, 25)
                    end
                end)
            end

            pivotPart.CFrame = Start
            pivotPart.AssemblyLinearVelocity  = Vector3.zero
            pivotPart.AssemblyAngularVelocity = Vector3.zero

            if headMode then
                Root.CFrame = Start * headOffset * rotateCF
                Root.AssemblyLinearVelocity  = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero
            else
                Root.CFrame = Start * WeldOffset * rotateCF
                Root.AssemblyLinearVelocity  = WeldVelocity
                Root.AssemblyAngularVelocity = Vector3.zero
            end

            RenderStepped:Wait()
            if not Enabled then continue end
            if not pivotPart or not pivotPart.Parent then break end

            pivotPart.CFrame = Start
            pivotPart.AssemblyLinearVelocity  = Vector3.zero
            pivotPart.AssemblyAngularVelocity = Vector3.zero

            if headMode then
                Root.CFrame = Start * (headOffset + Vector3.new(0, yOffset, 0)) * rotateCF
                Root.AssemblyLinearVelocity  = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero
            else
                Root.CFrame = Start * CFrame.new(0, 4, 0) * rotateCF
                Root.AssemblyLinearVelocity  = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end)

    Weld:Enable(true)
    CurrentWeld = Weld
    return Weld
end

function Unweld()
    if CurrentWeld then
        CurrentWeld:Destroy()
        CurrentWeld = nil
    end
end

