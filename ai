-- FACEBANG (exact from source)
-- ============================================
do
    local facebangSetupChar = nil
    local flag8 = false
    local tbl17 = {}
    local track = nil

    fbCleanup = function(character2)
        facebangSetupChar = nil
        clearPhysicsRep()
        if not character2 then
            character2 = localPlayer.Character or character
        end
        if track then
            pcall(function() track:Stop(0); track:Destroy() end)
            track = nil
        end
        if character2 then
            local flag9 = false
            for _, v6 in ipairs(AttachFeatures) do
                if tbl[v6] then flag9 = true; break end
            end
            if not flag9 then
                local animate = character2:FindFirstChild("Animate")
                if animate and flag8 then
                    animate.Disabled = false
                    flag8 = false
                end
                local humanoid2 = character2:FindFirstChildOfClass("Humanoid")
                if humanoid2 then
                    humanoid2.PlatformStand = false
                    humanoid2.AutoRotate = true
                    pcall(function() humanoid2:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                end
                pcall(function() Workspace.Gravity = 192.2 end)
            end
            for k, v6 in pairs(tbl17) do
                if k and k.Parent then
                    pcall(function() k.CanCollide = v6.CanCollide end)
                end
            end
            table.clear(tbl17)
        end
    end

    local function fn16(character2)
        if not character2 then return end
        local animate = character2:FindFirstChild("Animate")
        if animate and not animate.Disabled then
            animate.Disabled = true
            flag8 = true
        end
        local humanoid2 = character2:FindFirstChildOfClass("Humanoid")
        if not humanoid2 then return end
        local animator = humanoid2:FindFirstChildOfClass("Animator") or humanoid2
        for _, v6 in ipairs(animator:GetPlayingAnimationTracks() or {}) do
            if v6 ~= track then
                pcall(function() v6:Stop(0); v6:Destroy() end)
            end
        end
        for _, v6 in ipairs(humanoid2:GetPlayingAnimationTracks() or {}) do
            if v6 ~= track then
                pcall(function() v6:Stop(0); v6:Destroy() end)
            end
        end
        pcall(function()
            if not (track and track.IsPlaying) then
                local animation = Instance.new("Animation")
                animation.AnimationId = "rbxassetid://116235062592344"
                track = animator:LoadAnimation(animation)
                track.Priority = Enum.AnimationPriority.Action4
                track.Looped = true
                track:Play()
            end
        end)
        humanoid2.PlatformStand = true
        humanoid2.AutoRotate = false
        pcall(function() humanoid2:ChangeState(Enum.HumanoidStateType.Physics) end)
        pcall(function() Workspace.Gravity = 0 end)
        for _, part in ipairs(character2:GetDescendants() or {}) do
            if part:IsA("BasePart") then
                if tbl17[part] == nil then
                    tbl17[part] = { CanCollide = part.CanCollide }
                end
                part.CanCollide = false
            end
        end
    end

    fbComputeCFrame = function(arg)
        local n209 = 0.5 + ((math.sin(tick() * (tonumber(FacebangSpeed) or 1) * 10) + 1) / 2) * (tonumber(FacebangDistance) or 5)
        local lookVector = arg.CFrame.LookVector
        local vector2 = Vector3.new(lookVector.X, 0, lookVector.Z)
        local unit = vector2.Magnitude > 0 and vector2.Unit or Vector3.new(0, 0, 1)
        local position4 = arg.Position
        local n210 = position4 + unit * n209
        local vector3 = Vector3.new(n210.X, position4.Y + 1.2, n210.Z)
        return CFrame.lookAt(vector3, Vector3.new(position4.X, vector3.Y, position4.Z))
    end

    fbApplyCFrame = function(arg)
        if tbl.Facebang and humanoidRootPart then
            local facebangTarget = FacebangTarget or ctxTargetPlayer or TargetPlayer
            if facebangTarget and facebangTarget.Character then
                local head = facebangTarget.Character:FindFirstChild("Head")
                if not head then return false end
                local humanoidRootPart2 = facebangTarget.Character:FindFirstChild("HumanoidRootPart")
                local cFrame = fbComputeCFrame(head)
                if arg and tbl.NoDelay and typeof(sethiddenproperty) == "function" and humanoidRootPart2 then
                    local cframe = humanoidRootPart2.CFrame:ToObjectSpace(cFrame)
                    humanoidRootPart.CFrame = cframe
                    humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                    humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
                else
                    humanoidRootPart.CFrame = cFrame
                    if humanoidRootPart2 then
                        humanoidRootPart.AssemblyLinearVelocity = humanoidRootPart2.AssemblyLinearVelocity
                        humanoidRootPart.AssemblyAngularVelocity = humanoidRootPart2.AssemblyAngularVelocity
                    else
                        humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                        humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
                    end
                end
                pcall(function() humanoidRootPart.Velocity = humanoidRootPart.AssemblyLinearVelocity end)
                pcall(function() humanoidRootPart.RotVelocity = Vector3.zero end)
                return true
            end
            return false
        end
        return false
    end

    fbActivate = function()
        local character2 = localPlayer.Character or character
        if not character2 then return end
        local tgt = resolveAttachTarget("Facebang", true)
        if tgt and tgt.Character and tgt.Character:FindFirstChild("Head") then
            FacebangTarget = tgt
            syncAttachTarget(tgt)
            facebangSetupChar = character2
            fn16(character2)
            if tbl.NoDelay then
                local hrp2 = tgt.Character:FindFirstChild("HumanoidRootPart")
                if hrp2 then setPhysicsRep(hrp2) end
            else
                clearPhysicsRep()
            end
        end
    end

    fbDeactivate = function()
        local tgt = FacebangTarget or TargetPlayer
        fbCleanup(localPlayer.Character or character)
        if tgt and tgt.Character then
            pcall(function()
                local hrp2 = tgt.Character:FindFirstChild("HumanoidRootPart")
                if hrp2 and humanoidRootPart then
                    humanoidRootPart.CFrame = hrp2.CFrame * CFrame.new(0, 0, 2)
                end
            end)
        end
        FacebangTarget = nil
        clearAutoSelectedTarget()
    end
end

