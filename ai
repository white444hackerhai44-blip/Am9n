local function refreshTargetList()
    for _, child in ipairs(targetListScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local query = targetSearchBox.Text:lower()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local name = player.Name:lower()
        local display = player.DisplayName:lower()
        if query == "" or name:find(query, 1, true) or display:find(query, 1, true) then
            local btn = Instance.new("TextButton", targetListScroll)
            btn.Size = UDim2.new(1, -4, 0, 32)
            btn.BackgroundColor3 = T.TargetPlayer == player and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(25, 25, 25)
            btn.BorderSizePixel = 0
            btn.Text = "  " .. player.DisplayName .. "  (@" .. player.Name .. ")"
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 11
            btn.TextColor3 = Color3.fromRGB(240, 240, 240)
            btn.TextXAlignment = Enum.TextXAlignment.Left
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
            btn.MouseButton1Click:Connect(function()
                if T.TargetPlayer == player then updateTargetDisplay(nil) else updateTargetDisplay(player) end
                refreshTargetList()
            end)
        end
    end
end

