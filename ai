    worker = task.spawn(function()
        local forward = true
        local pos = FB_OFF_Z - FB_DIST
        local last = tick()

        while mode == "facebang" do
            local now = tick()
            local dt = now - last
            last = now

            pcall(function()
                local myroot = get_root(LocalPlayer)
                local troot  = get_root(target)
                local thead  = get_head(target)
                if myroot and troot and thead then
                    pcall(function() sethiddenproperty(myroot, "PhysicsRepRootPart", troot) end)

                    local near_z = FB_OFF_Z
                    local far_z  = FB_OFF_Z - FB_DIST

                    if forward then
                        pos = pos + FB_SPEED * dt
                        if pos >= near_z then pos = near_z; forward = false end
                    else
                        pos = pos - FB_SPEED * dt
                        if pos <= far_z then pos = far_z; forward = true end
                    end

                    local placed = thead.CFrame * CFrame.new(FB_OFF_X, FB_OFF_Y, pos)
                    myroot.CFrame = CFrame.lookAt(placed.Position, thead.Position)
                    myroot.AssemblyLinearVelocity  = Vector3.zero
                    myroot.AssemblyAngularVelocity = Vector3.zero
                end
            end)

            RunService.Heartbeat:Wait()
        end
        stop_clap()
    end)
end

