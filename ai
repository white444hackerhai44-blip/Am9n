-- ============================================
-- TARGET RESOLUTION
-- ============================================
resolveAttachTarget = function(feature, needHead)
    local fallback = ctxTargetPlayer or TargetPlayer
    if fallback and fallback.Character then
        if needHead and not fallback.Character:FindFirstChild("Head") then
            fallback = nil
        end
    end
    if fallback then return fallback end
    -- pick nearest
    local myChar = localPlayer.Character
    local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    if not myHrp then return nil end
    local nearest, dist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Torso")
            if hrp then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    local d = (hrp.Position - myHrp.Position).Magnitude
                    if d < dist then
                        dist = d
                        nearest = p
                    end
                end
            end
        end
    end
    return nearest
end

syncAttachTarget = function(p)
    if p then TargetPlayer = p end
end

clearAutoSelectedTarget = function() end

-- ============================================
-- SET ATTACH STATE
-- ============================================
SetAttachState = function(name, on)
    if on then
        if tbl.AdminDisabled or tbl.AttachLockedDisabled then
            SendNotification("Blocked", "Attach features disabled by admin.", 2)
            return
        end
        if tbl.AdminFrozen then
            SendNotification("Blocked", "Cannot attach while frozen!", 2)
            return
        end
        for _, f in ipairs(AttachFeatures) do
            if f ~= name and tbl[f] then
                SendNotification("Blocked", "Turn off " .. f .. " first!", 2)
                return
            end
        end
        local tgt = resolveAttachTarget(name, name ~= "Bagpack" and name ~= "Hipbang" and name ~= "CustomAttach")
        if not tgt then
            SendNotification("Eternity", "No target found!", 2)
            return
        end
        if name == "Facebang" then
            FacebangTarget = tgt; fbActivate()
        elseif name == "Hipbang" then
            HipbangTarget = tgt; hbActivate()
        elseif name == "Pat" then
            PatTarget = tgt; patActivate()
        elseif name == "Headsit" then
            HeadsitTarget = tgt; hsActivate()
        elseif name == "Backhug" then
            BackhugTarget = tgt; bhActivate()
        elseif name == "Fronthug" then
            FronthugTarget = tgt; fhActivate()
        elseif name == "Propose" then
            ProposeTarget = tgt; prActivate()
        elseif name == "Bagpack" then
            BagpackTarget = tgt; bgpActivate()
        elseif name == "Goon" then
            GoonTarget = tgt; goonActivate()
        elseif name == "CustomAttach" then
            CustomAttachTarget = tgt; customAttachActivate()
        end
        tbl[name] = true
        TargetPlayer = tgt
    else
        if name == "Facebang" then fbDeactivate()
        elseif name == "Hipbang" then hbDeactivate()
        elseif name == "Pat" then patDeactivate()
        elseif name == "Headsit" then hsDeactivate()
        elseif name == "Backhug" then bhDeactivate()
        elseif name == "Fronthug" then fhDeactivate()
        elseif name == "Propose" then prDeactivate()
        elseif name == "Bagpack" then bgpDeactivate()
        elseif name == "Goon" then goonDeactivate()
        elseif name == "CustomAttach" then customAttachDeactivate()
        end
        tbl[name] = false
    end
end

