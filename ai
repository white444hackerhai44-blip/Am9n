-- target resolution
local function isTargetValidAndAlive(model)
    if not model then return false end
    local char = model.Character
    if not char then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not hrp then return false end
    return true
end

resolveAttachTarget = function(feature, needHead)
    local fallback = TargetPlayer or FacebangTarget or HipbangTarget or PatTarget
        or HeadsitTarget or BackhugTarget or FronthugTarget or ProposeTarget
        or BagpackTarget or GoonTarget or CustomAttachTarget
    if fallback and fallback.Character then
        if needHead and not fallback.Character:FindFirstChild("Head") then
            return nil
        end
        return fallback
    end
    -- pick nearest
    local nearest, dist = nil, math.huge
    local myChar = localPlayer.Character
    local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    if not myHrp then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Torso")
            if hrp then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    local d = (hrp.Position - myHrp.Position).Magnitude
                    if d < dist then
                        dist = d
                        nearest = p
                    end
                end
            end
        end
    end
    return nearest
end

syncAttachTarget = function(p)
    if p then
        TargetPlayer = p
    end
end

clearAutoSelectedTarget = function() end

-- set attach state
SetAttachState = function(name, on)
    if on then
        if tbl.AdminDisabled or tbl.AttachLockedDisabled then
            SendNotification("Blocked", "Attach features disabled by admin.", 2)
            return
        end
        if tbl.AdminFrozen then
            SendNotification("Blocked", "Cannot attach while frozen!", 2)
            return
        end
        -- turn off others
        for _, f in ipairs(AttachFeatures) do
            if f ~= name and tbl[f] then
                SendNotification("Blocked", "Turn off " .. f .. " first!", 2)
                return
            end
        end
        local tgt = resolveAttachTarget(name, name ~= "Bagpack" and name ~= "Hipbang" and name ~= "CustomAttach")
        if not tgt then
            SendNotification("Eternity", "No target found!", 2)
            return
        end
        if name == "Facebang" then
            FacebangTarget = tgt; fbSetup()
        elseif name == "Hipbang" then
            HipbangTarget = tgt; hbSetup()
        else
            simpleAttachState[name].setup()
        end
        tbl[name] = true
        TargetPlayer = tgt
    else
        if name == "Facebang" then
            fbCleanup()
            FacebangTarget = nil
        elseif name == "Hipbang" then
            hbCleanup()
            HipbangTarget = nil
        else
            if simpleAttachState[name] then simpleAttachState[name].cleanup() end
        end
        tbl[name] = false
    end
end

