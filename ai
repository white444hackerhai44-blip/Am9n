local tab_buttons = {}

local function make_tab(name, order)
    local btn = new("TextButton", {
        Size = UDim2.new(0, 90, 1, 0),
        Position = UDim2.new(0, (order-1)*90, 0, 0),
        BackgroundColor3 = COL.tabbar,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Font = Enum.Font.Gotham,
        Text = name,
        TextColor3 = COL.text_dim,
        TextSize = 12,
        AutoButtonColor = false,
        ZIndex = 3,
        Parent = tabbar,
    })
    corner(btn, 4)

    local page = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 2,
        Parent = content,
    })
    new("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = page,
    })

    tab_buttons[name] = { btn = btn, page = page }

    local function select()
        for _, t in pairs(tab_buttons) do
            t.btn.BackgroundTransparency = 1
            t.btn.TextColor3 = COL.text_dim
            t.page.Visible = false
        end
        btn.BackgroundTransparency = 0.2
        btn.BackgroundColor3 = COL.tab_active
        btn.TextColor3 = COL.text
        page.Visible = true
    end

    btn.MouseButton1Click:Connect(select)
    btn.MouseEnter:Connect(function() if not page.Visible then btn.TextColor3 = COL.text end end)
    btn.MouseLeave:Connect(function() if not page.Visible then btn.TextColor3 = COL.text_dim end end)

    return page, select
end

local main_page, select_main = make_tab("Main", 1)
local chat_page, select_chat = make_tab("Chat", 2)

