-- SLIDER FACTORY
-- ============================================================
local function make_slider(parent, y, name, min, max, default, fill_color, on_change)
    local label = new("TextLabel", {
        Size = UDim2.new(1, -16, 0, 18),
        Position = UDim2.new(0, 8, 0, y),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = string.format("%s: %.1f", name, default),
        TextColor3 = COL.text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
        Parent = parent,
    })

    local track = new("Frame", {
        Size = UDim2.new(1, -16, 0, 8),
        Position = UDim2.new(0, 8, 0, y + 28),
        BackgroundColor3 = COL.btn,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = parent,
    })
    corner(track, 4)
    stroke(track, COL.outline, 1)

    local norm = (default - min) / (max - min)

    local fill = new("Frame", {
        Size = UDim2.new(norm, 0, 1, 0),
        BackgroundColor3 = fill_color,
        BorderSizePixel = 0,
        ZIndex = 3,
        Parent = track,
    })
    corner(fill, 4)

    local dot = new("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(norm, 0, 0.5, 0),
        BackgroundColor3 = COL.text,
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = track,
    })
    corner(dot, 7)

    local hit = new("TextButton", {
        Size = UDim2.new(1, 0, 3, 0),
        Position = UDim2.new(0, 0, -1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 5,
        Parent = track,
    })

    local dragging = false

    local function set_from_x(abs_x)
        local rel = math.clamp((abs_x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = min + (max - min) * rel
        v = math.floor(v * 10 + 0.5) / 10
        fill.Size = UDim2.new(rel, 0, 1, 0)
        dot.Position = UDim2.new(rel, 0, 0.5, 0)
        label.Text = string.format("%s: %.1f", name, v)
        on_change(v)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            set_from_x(input.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            set_from_x(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

