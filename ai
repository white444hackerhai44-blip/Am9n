-- ============================================================
-- PRIMITIVES
-- ============================================================
local function new(class, props, children)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = o end
    return o
end
local function corner(p, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 4), Parent = p}) end
local function stroke(p, color, thick)
    return new("UIStroke", {
        Color = color or COL.outline,
        Thickness = thick or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = p,
    })
end
-- glow: outline stroke directly on text glyphs
local function glow(p, strength)
    return new("UIStroke", {
        Color = GLOW_COLOR,
        Thickness = strength or 1.5,
        Transparency = 0.25,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
        LineJoinMode = Enum.LineJoinMode.Round,
        Parent = p,
    })
end

