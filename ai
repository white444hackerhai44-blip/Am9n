RunService.Heartbeat:Connect(function(dt)
    if viewport.CurrentCamera ~= cam then viewport.CurrentCamera = cam end
    if not current_model then return end
    local hrp = current_model:FindFirstChild("HumanoidRootPart") or current_model.PrimaryPart
    if not hrp then return end
    if current_model.Parent ~= world then current_model.Parent = world end

    angle = (angle + dt * math.rad(24)) % (math.pi * 2)
    local origin = hrp.Position
    local radius = 11
    local pos = origin + Vector3.new(math.cos(angle) * radius, 2.2, math.sin(angle) * radius)
    cam.CFrame = CFrame.lookAt(pos, origin + Vector3.new(0, 0.1, 0))
end)

