do
    local hbSetupChar = nil
    local hbWasAnimateDisabled = false
    local hbAnimTrack = nil
    local hbOriginalParts = {}

    hbCleanup = function()
        clearPhysicsRep()
        if hbAnimTrack then
            pcall(function() hbAnimTrack:Stop(0); hbAnimTrack:Destroy() end)
            hbAnimTrack = nil
        end
        if character then
            local humanoid2 = character:FindFirstChildOfClass("Humanoid")
            if humanoid2 then
                humanoid2.PlatformStand = false
                humanoid2.AutoRotate = true
                pcall(function() humanoid2:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
            if hbWasAnimateDisabled then
                local animate = character:FindFirstChild("Animate")
                if animate then animate.Disabled = false end
                hbWasAnimateDisabled = false
            end
        end
        pcall(function() Workspace.Gravity = 192.2 end)
        for k, v6 in pairs(hbOriginalParts) do
            if k and k.Parent then
                pcall(function() k.CanCollide = v6.CanCollide end)
            end
        end
        table.clear(hbOriginalParts)
        hbSetupChar = nil
    end

    hbSetup = function()
        local character2 = localPlayer.Character or character
        if not character2 then return end
        if hbSetupChar == character2 then
            if hbAnimTrack and hbAnimTrack.IsPlaying then return true end
            hbSetupChar = nil
        end
        hbCleanup()
        local humanoid2 = character2:FindFirstChildOfClass("Humanoid")
        if not humanoid2 then return end
        humanoid2.AutoRotate = false
        local animator = humanoid2:FindFirstChildOfClass("Animator")
        if not animator then animator = Instance.new("Animator"); animator.Parent = humanoid2 end
        local animate = character2:FindFirstChild("Animate")
        if animate and not animate.Disabled then
            animate.Disabled = true
            hbWasAnimateDisabled = true
        end
        for _, v6 in ipairs(animator:GetPlayingAnimationTracks() or {}) do pcall(function() v6:Stop(0) end) end
        for _, v6 in ipairs(humanoid2:GetPlayingAnimationTracks() or {}) do pcall(function() v6:Stop(0) end) end
        humanoid2.PlatformStand = true
        pcall(function() humanoid2:ChangeState(Enum.HumanoidStateType.Physics) end)
        pcall(function() Workspace.Gravity = 0 end)
        pcall(function()
            local animation = Instance.new("Animation")
            animation.AnimationId = "rbxassetid://" .. tostring(116235062592344)
            hbAnimTrack = animator:LoadAnimation(animation)
            hbAnimTrack.Priority = Enum.AnimationPriority.Action
            hbAnimTrack.Looped = true
            hbAnimTrack:Play()
        end)
        for _, part in ipairs(character2:GetDescendants() or {}) do
            if part:IsA("BasePart") then
                hbOriginalParts[part] = { CanCollide = part.CanCollide }
                part.CanCollide = false
            end
        end
        hbSetupChar = character2
        return true
    end

    hbComputeCFrame = function(instance2)
        local n204 = tonumber(HipbangSpeed) or 1
        local n205 = tonumber(HipbangDistance) or 2.5
        local n206 = 0.5 + (math.sin(tick() * n204 * 10) + 1) / 2 * n205
        local lookVector = instance2.CFrame.LookVector
        local vector2 = Vector3.new(lookVector.X, 0, lookVector.Z)
        local unit = vector2.Magnitude > 0 and vector2.Unit or Vector3.new(0,0,1)
        local parent = instance2.Parent
        local y
        if parent then
            local hrp = parent:FindFirstChild("HumanoidRootPart")
            y = hrp and hrp.Position.Y or (instance2.Position.Y - 1.5)
        else
            y = instance2.Position.Y - 1.5
        end
        local position4 = instance2.Position
        local n207 = position4 - unit * n206
        local vector4 = Vector3.new(n207.X, y, n207.Z)
        return CFrame.lookAt(vector4, Vector3.new(position4.X, vector4.Y, position4.Z))
    end

    hbApplyCFrame = function(arg)
        if tbl.Hipbang and HipbangTarget and HipbangTarget.Character and humanoidRootPart then
            local head = HipbangTarget.Character:FindFirstChild("Head")
