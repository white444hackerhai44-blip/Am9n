            corner(av, 5)
            local n = Instance.new("TextLabel", f)
            n.Text = p.DisplayName
            n.Size = UDim2.new(1, -46, 0, 16)
            n.Position = UDim2.new(0, 42, 0, 6)
            n.BackgroundTransparency = 1
            n.TextColor3 = isSel and Color3.new(0,0,0) or tbl3.text
            n.TextXAlignment = Enum.TextXAlignment.Left
            n.Font = Enum.Font.GothamBold
            n.TextSize = 12
            n.ZIndex = 4
            local u = Instance.new("TextLabel", f)
            u.Text = "@" .. p.Name
            u.Size = UDim2.new(1, -46, 0, 14)
            u.Position = UDim2.new(0, 42, 0, 23)
            u.BackgroundTransparency = 1
            u.TextColor3 = isSel and Color3.fromRGB(50,50,50) or tbl3.textMuted
            u.TextXAlignment = Enum.TextXAlignment.Left
            u.Font = Enum.Font.Gotham
            u.TextSize = 10
            u.ZIndex = 4
            local btn = Instance.new("TextButton", f)
            btn.Size = UDim2.new(1, 0, 1, 0)
            btn.BackgroundTransparency = 1
            btn.Text = ""
            btn.ZIndex = 5
            btn.MouseButton1Click:Connect(function()
