grip.InputBegan:Connect(function(input)
    if minimized then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        resizing = true
        resize_start_mouse = input.Position
        resize_start_w = W
        resize_start_h = H
    end
end)

UIS.InputChanged:Connect(function(input)
    if not resizing then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local dx = input.Position.X - resize_start_mouse.X
        local dy = input.Position.Y - resize_start_mouse.Y
        local new_w = math.clamp(resize_start_w + dx, MIN_W, MAX_W)
        local new_h = math.clamp(resize_start_h + dy, MIN_H, MAX_H)
        W = new_w
        H = new_h
        main.Size = UDim2.new(0, W, 0, H)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        resizing = false
    end
end)

