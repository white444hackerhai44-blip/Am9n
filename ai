local function resolve_target(name)
    name = name:lower()
    if name == "" then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if p.Name:lower():find(name, 1, true) or p.DisplayName:lower():find(name, 1, true) then
                return p
            end
        end
    end
    return nil
end

