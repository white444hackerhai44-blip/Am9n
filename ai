-- Keybind handling
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == tbl2.Facebang and tbl.FacebangEnabled then
        if not tbl.Facebang then
            SetAttachState("Facebang", true)
        else
            SetAttachState("Facebang", false)
        end
        if GridButtonVisuals.Facebang then GridButtonVisuals.Facebang(tbl.Facebang) end
    elseif input.KeyCode == tbl2.Hipbang and tbl.HipbangEnabled then
        if not tbl.Hipbang then
            SetAttachState("Hipbang", true)
        else
            SetAttachState("Hipbang", false)
        end
    elseif input.KeyCode == tbl2.Pat and tbl.PatEnabled then
        SetAttachState("Pat", not tbl.Pat)
        if gridRenders.Pat then gridRenders.Pat(tbl.Pat) end
    elseif input.KeyCode == tbl2.Headsit and tbl.HeadsitEnabled then
        SetAttachState("Headsit", not tbl.Headsit)
        if gridRenders.Headsit then gridRenders.Headsit(tbl.Headsit) end
    elseif input.KeyCode == tbl2.Backhug and tbl.BackhugEnabled then
        SetAttachState("Backhug", not tbl.Backhug)
        if gridRenders.Backhug then gridRenders.Backhug(tbl.Backhug) end
    elseif input.KeyCode == tbl2.Fronthug and tbl.FronthugEnabled then
        SetAttachState("Fronthug", not tbl.Fronthug)
        if gridRenders.Fronthug then gridRenders.Fronthug(tbl.Fronthug) end
    elseif input.KeyCode == tbl2.Propose and tbl.ProposeEnabled then
        SetAttachState("Propose", not tbl.Propose)
        if gridRenders.Propose then gridRenders.Propose(tbl.Propose) end
    elseif input.KeyCode == tbl2.Bagpack and tbl.BagpackEnabled then
        SetAttachState("Bagpack", not tbl.Bagpack)
        if gridRenders.Bagpack then gridRenders.Bagpack(tbl.Bagpack) end
    elseif input.KeyCode == tbl2.Goon and tbl.GoonEnabled then
        SetAttachState("Goon", not tbl.Goon)
        if gridRenders.Goon then gridRenders.Goon(tbl.Goon) end
    elseif input.KeyCode == tbl2.CustomAttach and tbl.CustomAttachEnabled then
        SetAttachState("CustomAttach", not tbl.CustomAttach)
        if gridRenders.CustomAttach then gridRenders.CustomAttach(tbl.CustomAttach) end
    elseif input.KeyCode == tbl2.ToggleGUI then
        screenGui.Enabled = not screenGui.Enabled
    elseif input.KeyCode == tbl2.MinimizeGUI then
        mainFrame.Visible = not mainFrame.Visible
    end
end)

-- drag
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

