    halo.Position = UDim2.new(0.5, 0, 0.5, 0)
    halo.AnchorPoint = Vector2.new(0.5, 0.5)
    halo.BackgroundTransparency = 1
    corner(halo, 999)
    local haloStroke = Instance.new("UIStroke", halo)
    haloStroke.Color = tbl3.toggleOn
    haloStroke.Thickness = 5
    haloStroke.Transparency = 1

    local clickBtn = Instance.new("TextButton", frame)
    clickBtn.Size = UDim2.new(1, -60, 1, 0)
    clickBtn.BackgroundTransparency = 1
    clickBtn.Text = ""
    clickBtn.ZIndex = 5

    local state = tbl[key] or false

    local function render()
        if state then
            tween(toggleFrame, { BackgroundColor3 = Color3.fromRGB(25,25,25) }, 0.25)
            tween(knob, {
                BackgroundColor3 = tbl3.toggleOn,
                Position = UDim2.new(0, 25, 0.5, -8),
            }, 0.25, Enum.EasingStyle.Back)
            tween(haloStroke, { Transparency = 0.65 }, 0.25)
        else
            tween(toggleFrame, { BackgroundColor3 = Color3.fromRGB(15,15,15) }, 0.25)
            tween(knob, {
                BackgroundColor3 = Color3.fromRGB(100,100,100),
                Position = UDim2.new(0, 3, 0.5, -8),
            }, 0.25, Enum.EasingStyle.Back)
            tween(haloStroke, { Transparency = 1 }, 0.25)
        end
    end

    local function setState(v, silent)
        state = v
        tbl[key] = v
        render()
        if callback then callback(v) end
        if not silent then playClick() end
    end

    ToggleRegistry[key] = setState

    clickBtn.MouseButton1Click:Connect(function()
        setState(not state)
    end)

    -- key bind
    local listening = false
    keyBtn.MouseButton1Click:Connect(function()
        listening = true
        keyBtn.Text = "..."
        playClick()
    end)
    UserInputService.InputBegan:Connect(function(input)
        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            local kc = input.KeyCode
            if kc ~= Enum.KeyCode.Escape then
                tbl2[bindKey] = kc
                keyBtn.Text = kc.Name
            else
                keyBtn.Text = tbl2[bindKey].Name
            end
            listening = false
        end
    end)

    render()
    return frame, setState, keyBtn
end

