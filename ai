local function start_bang()
    if not target then status_label.Text = "select a target first"; status_label.TextColor3 = COL.accent; return end
    if mode == "bang" then stop_all(); return end
    stop_all()
    mode = "bang"
    bang_btn.BackgroundColor3 = COL.btn_bang
    bang_btn.Text = "banging..."
    if clap_on then start_clap() end

    worker = task.spawn(function()
        local forward = true
        local pos = BANG_MAX
        local last = tick()

        while mode == "bang" do
            local now = tick()
            local dt = now - last
            last = now

            pcall(function()
                local myroot = get_root(LocalPlayer)
                local troot  = get_root(target)
                if myroot and troot then
                    pcall(function() sethiddenproperty(myroot, "PhysicsRepRootPart", troot) end)

                    if forward then
                        pos = pos - BANG_SPEED * dt
                        if pos <= BANG_MIN then pos = BANG_MIN; forward = false end
                    else
                        pos = pos + BANG_SPEED * dt
                        if pos >= BANG_MAX then pos = BANG_MAX; forward = true end
                    end

                    myroot.CFrame = troot.CFrame * CFrame.new(0, 0, pos)
                    myroot.CFrame = CFrame.lookAt(myroot.Position, troot.Position)
                    myroot.AssemblyLinearVelocity  = Vector3.zero
                    myroot.AssemblyAngularVelocity = Vector3.zero
                end
            end)

            RunService.Heartbeat:Wait()
        end
        stop_clap()
    end)
end

