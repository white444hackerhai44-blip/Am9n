local targetRemovingConn = nil
local myCharacterConn = nil

local function waitForHRP(char, timeout)
    timeout = timeout or 8
    local start = tick()
    while tick() - start < timeout do
        if char and char.Parent then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then return hrp end
        end
        task.wait(0.1)
    end
    return nil
end

local function disconnectTargetListeners()
    if targetCharacterConn then
        targetCharacterConn:Disconnect()
        targetCharacterConn = nil
    end
    if targetRemovingConn then
        targetRemovingConn:Disconnect()
        targetRemovingConn = nil
    end
end

local function stopBangs()
    Unweld()
end

local function resetAllButtons()
    frontBangOn = false
    headBangOn = false
    FrontBangBtn.Text = "INSIDE FLING [OFF]"
    FrontBangBtn.BackgroundColor3 = Color3.fromRGB(140, 0, 0)
    HeadBangBtn.Text = "STAND ON HEAD [OFF]"
    HeadBangBtn.BackgroundColor3 = Color3.fromRGB(140, 0, 0)
end

local function startBang(targetName, speed, mode, isResume)
    stopBangs()
    if not isResume then
        savedTargetName = targetName
        savedSpeed = speed
        savedMode = mode
    end

    local target = getTargetPlayer(targetName)
    if not target or not target.Character then
        warn("[AMEN FLING] Target not found!")
        return
    end
    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end

    local myHRP = waitForHRP(LocalPlayer.Character, 5)
    if not myHRP then return end

    setWeldSpeed(speed)

    local targetHead = target.Character:FindFirstChild("Head")
    local waited = 0
    while not targetHead and waited < 5 do
        task.wait(0.1)
        waited = waited + 0.1
        targetHead = target.Character:FindFirstChild("Head")
    end

    if targetHead then
        if mode == "head" then
            myHRP.CFrame = targetHead.CFrame + Vector3.new(0, 3.0, 0)
        else
            myHRP.CFrame = targetHead.CFrame + Vector3.new(0, 0.5, 0)
        end
    else
        myHRP.CFrame = targetHRP.CFrame + Vector3.new(0, 3.0, 0)
    end

    changeWeldOffset(CFrame.new(0, 0, 0))
    disconnectTargetListeners()

    targetCharacterConn = target.CharacterAdded:Connect(function(newChar)
        if not (frontBangOn or headBangOn) then return end
        task.wait(1)
        if not (frontBangOn or headBangOn) then return end
        local newHRP = waitForHRP(newChar, 8)
        if newHRP then
            startBang(savedTargetName, savedSpeed, savedMode, true)
        end
    end)

    targetRemovingConn = target.AncestryChanged:Connect(function()
        if not target:IsDescendantOf(game) and (frontBangOn or headBangOn) then
            stopBangs()
            resetAllButtons()
            savedTargetName = nil
            disconnectTargetListeners()
            stopEmote()
        end
    end)

    if mode == "head" then
        PhysicalWeldTo(targetHRP, true, 3.0)
    else
        PhysicalWeldTo(targetHRP, true, 0.5)
    end
end

