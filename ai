local simpleAttachState = {
    Pat = { setup = nil, cleanup = nil, compute = nil, apply = nil },
    Headsit = { setup = nil, cleanup = nil, compute = nil, apply = nil },
    Backhug = { setup = nil, cleanup = nil, compute = nil, apply = nil },
    Fronthug = { setup = nil, cleanup = nil, compute = nil, apply = nil },
    Propose = { setup = nil, cleanup = nil, compute = nil, apply = nil },
    Bagpack = { setup = nil, cleanup = nil, compute = nil, apply = nil },
    Goon = { setup = nil, cleanup = nil, compute = nil, apply = nil },
    CustomAttach = { setup = nil, cleanup = nil, compute = nil, apply = nil },
}

local function makeSimpleAttach(name, animId, computeFn)
    local setupChar, track, original, wasDisabled = nil, nil, {}, false

    local function cleanup()
        clearPhysicsRep()
        if track then pcall(function() track:Stop(0); track:Destroy() end); track = nil end
        if setupChar then
            for k,v in pairs(original) do
                if k and k.Parent then pcall(function() k.CanCollide = v.CanCollide end) end
            end
            original = {}
            local h = setupChar:FindFirstChildOfClass("Humanoid")
            if h then
                h.PlatformStand = false
                h.AutoRotate = true
                pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
            local a = setupChar:FindFirstChild("Animate")
            if a and wasDisabled then a.Disabled = false end
            wasDisabled = false
            pcall(function() Workspace.Gravity = 192.2 end)
            setupChar = nil
        end
    end

    local function setup()
        local char = localPlayer.Character
        if not char then return false end
        if setupChar == char and track and track.IsPlaying then return true end
        cleanup()
        local h = char:FindFirstChildOfClass("Humanoid")
        if not h then return false end
        h.AutoRotate = false
        local animator = h:FindFirstChildOfClass("Animator")
        if not animator then animator = Instance.new("Animator"); animator.Parent = h end
        local animate = char:FindFirstChild("Animate")
        if animate and not animate.Disabled then animate.Disabled = true; wasDisabled = true end
        for _, t in ipairs(animator:GetPlayingAnimationTracks() or {}) do pcall(function() t:Stop(0) end) end
        for _, t in ipairs(h:GetPlayingAnimationTracks() or {}) do pcall(function() t:Stop(0) end) end
        h.PlatformStand = true
        pcall(function() h:ChangeState(Enum.HumanoidStateType.Physics) end)
        pcall(function() Workspace.Gravity = 0 end)
        if animId and animId ~= "" then
            pcall(function()
                local anim = Instance.new("Animation")
                anim.AnimationId = "rbxassetid://" .. animId
                track = animator:LoadAnimation(anim)
                track.Priority = Enum.AnimationPriority.Action4
                track.Looped = true
                track:Play()
            end)
        end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                original[p] = { CanCollide = p.CanCollide }
                p.CanCollide = false
            end
        end
        setupChar = char
        return true
    end

    local function apply(useRep)
        if not (tbl[name] and humanoidRootPart) then return false end
        local tgt = TargetPlayer
        if not (tgt and tgt.Character) then return false end
        local hrp = tgt.Character:FindFirstChild("HumanoidRootPart") or tgt.Character:FindFirstChild("Torso")
        if not hrp then return false end
        local cf = computeFn(hrp)
        if useRep and tbl.NoDelay and typeof(sethiddenproperty) == "function" then
            humanoidRootPart.CFrame = hrp.CFrame:ToObjectSpace(cf)
            humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
        else
            humanoidRootPart.CFrame = cf
            humanoidRootPart.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity
            humanoidRootPart.AssemblyAngularVelocity = hrp.AssemblyAngularVelocity
        end
        pcall(function() humanoidRootPart.Velocity = humanoidRootPart.AssemblyLinearVelocity end)
        pcall(function() humanoidRootPart.RotVelocity = Vector3.zero end)
        return true
    end

    return { setup = setup, cleanup = cleanup, apply = apply }
end

-- compute functions
local function patCompute(head)
    local look = head.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local unit = flat.Magnitude > 0 and flat.Unit or Vector3.new(0,0,1)
    local parent = head.Parent
    local hrp = parent and parent:FindFirstChild("HumanoidRootPart")
    local y = hrp and hrp.Position.Y or (head.Position.Y - 1.5)
    local pos = head.Position
    local p2 = pos + unit * 2.5
    local v3 = Vector3.new(p2.X, y, p2.Z)
    return CFrame.lookAt(v3, Vector3.new(pos.X, v3.Y, pos.Z))
end

local function hsCompute(head)
    return head.CFrame * CFrame.new(0, 1.5, 0)
end

local function bhCompute(head)
    local look = head.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local unit = flat.Magnitude > 0 and flat.Unit or Vector3.new(0,0,1)
    local parent = head.Parent
    local hrp = parent and parent:FindFirstChild("HumanoidRootPart")
    local y = hrp and hrp.Position.Y or (head.Position.Y - 1.5)
    local pos = head.Position
    local p2 = pos - unit * 1.25
    local v3 = Vector3.new(p2.X, y, p2.Z)
    return CFrame.lookAt(v3, Vector3.new(pos.X, v3.Y, pos.Z))
end

local function fhCompute(head)
    local look = head.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local unit = flat.Magnitude > 0 and flat.Unit or Vector3.new(0,0,1)
    local pos = head.Position
    local p2 = pos + unit * 1.1
    local v3 = Vector3.new(p2.X, pos.Y - 1.5, p2.Z)
    return CFrame.lookAt(v3, Vector3.new(pos.X, v3.Y, pos.Z))
end

local function prCompute(head)
    local look = head.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local unit = flat.Magnitude > 0 and flat.Unit or Vector3.new(0,0,1)
    local pos = head.Position
    local p2 = pos + unit * 3.5
    local v3 = Vector3.new(p2.X, pos.Y - 1.5, p2.Z)
    return CFrame.lookAt(v3, Vector3.new(pos.X, v3.Y, pos.Z))
end

local function bgpCompute(hrp)
    local look = hrp.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local unit = flat.Magnitude > 0 and flat.Unit or Vector3.new(0,0,1)
    local pos = hrp.Position
    local p2 = pos - unit * 1
    local v3 = Vector3.new(p2.X, pos.Y + 0.5, p2.Z)
    return CFrame.lookAt(v3, v3 - unit)
end

local function goonCompute(head)
    local parent = head.Parent
    local hrp = parent and parent:FindFirstChild("HumanoidRootPart")
    if not hrp then return head.CFrame * CFrame.new(0, 0, -4.5) end
    local look = hrp.CFrame.LookVector
    local right = hrp.CFrame.RightVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local flatR = Vector3.new(right.X, 0, right.Z)
    local unit = flat.Magnitude > 0 and flat.Unit or Vector3.new(0,0,1)
    local unitR = flatR.Magnitude > 0 and flatR.Unit or Vector3.new(1,0,0)
    local p = hrp.Position + unit * 4.5 + -unitR * 1.2
    local v3 = Vector3.new(p.X, head.Position.Y + 1.5, p.Z)
    return CFrame.lookAt(v3, v3 - unit)
end

local function customCompute(hrp)
    local ox = tonumber(CustomAttachOffsetX) or 0
    local oy = tonumber(CustomAttachOffsetY) or 0
    local oz = tonumber(CustomAttachOffsetZ) or 2.5
    local behind = CustomAttachFacing == "Behind"
    local look = hrp.CFrame.LookVector
    local right = hrp.CFrame.RightVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local flatR = Vector3.new(right.X, 0, right.Z)
    local unit = flat.Magnitude > 0 and flat.Unit or Vector3.new(0,0,1)
    local unitR = flatR.Magnitude > 0 and flatR.Unit or Vector3.new(1,0,0)
    local pos = hrp.Position
    if behind then
        local p = pos + -unit * oz + unitR * ox + Vector3.new(0, oy, 0)
        return CFrame.lookAt(p, p + unit)
    end
    local p = pos + unit * oz + unitR * ox + Vector3.new(0, oy, 0)
    return CFrame.lookAt(p, p - unit)
end

