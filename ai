        task.spawn(function()
            local hrp = newchar:FindFirstChild("HumanoidRootPart")
            if not hrp then hrp = newchar:WaitForChild("HumanoidRootPart", 3) end
            if hrp then
                if clap.Parent ~= hrp then
                    pcall(function() clap.Parent = hrp end)
                end
                pcall(function() clap:Play() end)
            end
        end)
    end
end)

-- ============================================================
-- GLOW PASS — outline every text element with a soft white stroke
-- ============================================================
local function apply_glow(root)
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            -- skip elements that already carry a stroke (borders on buttons)
            local has_stroke = false
            for _, c in ipairs(d:GetChildren()) do
                if c:IsA("UIStroke") then has_stroke = true; break end
            end
            if not has_stroke or d:IsA("TextLabel") then
                local g = Instance.new("UIStroke")
                g.Color = GLOW_COLOR
                g.Thickness = 1.4
                g.Transparency = 0.35
                g.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
                g.LineJoinMode = Enum.LineJoinMode.Round
                g.Parent = d
            end
        end
    end
end

pcall(apply_glow, gui)

