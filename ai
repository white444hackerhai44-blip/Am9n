-- ============================================================
-- LOOPING RETURN (10s / 15s)
-- ============================================================
local return_active = false
local return_mode = nil
local return_thread = nil

local function return_btn_for(sec)
    return sec == 10 and return10_btn or return15_btn
end

local function cancel_return()
    return_active = false
    return_mode = nil
    if return_thread then
        pcall(function() task.cancel(return_thread) end)
        return_thread = nil
    end
    for _, b in ipairs({return10_btn, return15_btn}) do
        b.BackgroundColor3 = COL.btn
        b.TextColor3 = COL.text_dim
    end
    return10_btn.Text = "loop 10s"
    return15_btn.Text = "loop 15s"
end

local function fast_snap(seconds)
    local t_end = tick() + (seconds or 1)
    while tick() < t_end do
        local mychar = LocalPlayer.Character
        local myroot = mychar and mychar:FindFirstChild("HumanoidRootPart")
        local troot  = get_root(target)
        if myroot and troot then
            pcall(function()
                myroot.CFrame = troot.CFrame * CFrame.new(0, 0, 1)
                myroot.AssemblyLinearVelocity = Vector3.zero
                myroot.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        task.wait(0.03)
    end
end

local function start_return(sec)
    if not target then
        status_label.Text = "select a target first"
        status_label.TextColor3 = COL.accent
        return
    end
    if return_active and return_mode == sec then
        cancel_return()
        return
    end
    cancel_return()

    return_active = true
    return_mode = sec

    local btn = return_btn_for(sec)
    btn.BackgroundColor3 = COL.btn_active
    btn.TextColor3 = COL.btn_text

    return_thread = task.spawn(function()
        while return_active and return_mode == sec do
            local aborted = false
            for i = sec, 1, -1 do
                if not return_active or return_mode ~= sec then aborted = true; break end
                btn.Text = string.format("%ds", i)
                task.wait(1)
            end
            if aborted then return end
            if not return_active or return_mode ~= sec then return end

            if not target then
                status_label.Text = "target left"
                status_label.TextColor3 = COL.accent
                cancel_return()
                return
            end

            local mychar = LocalPlayer.Character
            local myhum = mychar and mychar:FindFirstChildOfClass("Humanoid")
            if myhum then
                btn.Text = "..."
                pcall(function() myhum.Health = 0 end)
                task.spawn(function()
                    task.wait(2)
                    if myhum and myhum.Parent and myhum.Health > 0 then
                        pcall(function() myhum:ChangeState(Enum.HumanoidStateType.Dead) end)
                        if LocalPlayer.Character then
                            pcall(function() LocalPlayer.Character:BreakJoints() end)
                        end
                    end
                end)
            end

            local newchar
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
               and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
               and LocalPlayer.Character.Humanoid.Health > 0 then
                newchar = LocalPlayer.Character
            else
                newchar = LocalPlayer.CharacterAdded:Wait()
            end

            newchar:WaitForChild("HumanoidRootPart", 5)
            task.wait(0.1)

            if return_active and return_mode == sec then
                btn.Text = "snap"
                fast_snap(1)
            end

            if return_active and return_mode == sec then
                btn.Text = string.format("%ds", sec)
                task.wait(0.3)
            end
        end
    end)
end

return10_btn.MouseButton1Click:Connect(function() start_return(10) end)
