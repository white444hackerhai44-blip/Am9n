local function make_section(parent, name, height, order)
    local sec = new("Frame", {
        Size = UDim2.new(1, 0, 0, height or 100),
        BackgroundColor3 = COL.section,
        BorderSizePixel = 0,
        LayoutOrder = order or 0,
