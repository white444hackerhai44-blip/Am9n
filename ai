local function decorate(text)
    if not decor_on then return text end
    if text == nil or text == "" then return text end
    local d = current_decor()
    return d.top .. SPAM_SEP .. text .. SPAM_SEP .. d.bot
end

local function send_message(raw_text)
    local text = decorate(raw_text)
    if text == nil or text == "" then return false end
    local ok = pcall(function()
        local replicated = game:GetService("ReplicatedStorage")
        local default_chat = replicated:FindFirstChild("DefaultChatSystemChatEvents")
        if default_chat and default_chat:FindFirstChild("SayMessageRequest") then
            default_chat.SayMessageRequest:FireServer(text, "All")
            return
        end
        local chat = game:GetService("TextChatService")
        if chat and chat.ChatVersion == Enum.ChatVersion.TextChatService then
            local channels = chat:FindFirstChild("TextChannels")
            local rb = channels and channels:FindFirstChild("RBXGeneral")
            if rb then rb:SendAsync(text); return end
            local general = channels and channels:FindFirstChild("General")
            if general then general:SendAsync(text); return end
        end
    end)
    if not ok then
        pcall(function()
            game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(text, "All")
        end)
    end
    return ok
end

local function stop_spam()
    spam_on = false
    if spam_thread then
        pcall(function() task.cancel(spam_thread) end)
        spam_thread = nil
    end
    chat_toggle.Text = "spam: off"
    chat_toggle.BackgroundColor3 = COL.btn
    chat_status.Text = "stopped"
end

local function start_spam()
    local msg = chat_input.Text
    if msg == nil or msg == "" then
        chat_status.Text = "no message entered"
        chat_status.TextColor3 = COL.accent
        return
    end
    if spam_on then stop_spam(); return end

    spam_on = true
    chat_toggle.Text = "spam: on"
    chat_toggle.BackgroundColor3 = COL.btn_active
    chat_status.Text = "spamming"
    chat_status.TextColor3 = COL.accent

    spam_thread = task.spawn(function()
        while spam_on do
            local cur = chat_input.Text
            if cur and cur ~= "" then
                send_message(cur)
            end
            task.wait(CHAT_DELAY)
        end
    end)
end

