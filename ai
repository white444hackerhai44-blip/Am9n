        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local targetHRP = attachTarget.Character:FindFirstChild("HumanoidRootPart")
        local targetHead = attachTarget.Character:FindFirstChild("Head")

        if T.NoDelay and targetHRP then
            pcall(function()
                if typeof(sethiddenproperty) == "function" then
                    sethiddenproperty(hrp, "PhysicsRepRootPart", targetHRP)
                    sethiddenproperty(LocalPlayer, "SimulationRadius", ZeroDelay.SimulationRadius)
                    sethiddenproperty(LocalPlayer, "MaxSimulationRadius", ZeroDelay.SimulationRadius)
                    settings().Physics.AllowSleep = false
                end
            end)
        elseif not T.NoDelay then
            pcall(function()
                if typeof(sethiddenproperty) == "function" then
                    sethiddenproperty(hrp, "PhysicsRepRootPart", nil)
                end
            end)
        end

        if T.Facebang and targetHead then
            local look = targetHead.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z).Unit
            local dist = 0.5 + ((math.sin(tick() * T.FacebangSpeed * 10) + 1) / 2) * T.FacebangDistance
            hrp.CFrame = CFrame.lookAt(targetHead.Position + flat * dist + Vector3.new(0, 1.2, 0), targetHead.Position)
        elseif T.Hipbang and targetHRP then
            local dist = 0.5 + ((math.sin(tick() * T.HipbangSpeed * 10) + 1) / 2) * T.HipbangDistance
            local look = targetHRP.CFrame.LookVector
            hrp.CFrame = CFrame.new(targetHRP.Position - Vector3.new(look.X, 0, look.Z).Unit * dist) * targetHRP.CFrame.Rotation
        elseif T.Headsit and targetHead then
            hrp.CFrame = targetHead.CFrame * CFrame.new(0, 1.5, 0)
        elseif T.Backhug and targetHead then
            local look = targetHead.CFrame.LookVector
            hrp.CFrame = CFrame.lookAt(targetHead.Position - Vector3.new(look.X, 0, look.Z).Unit * 1.25 + Vector3.new(0, 1.5, 0), targetHead.Position)
        elseif T.Fronthug and targetHead then
            local look = targetHead.CFrame.LookVector
            hrp.CFrame = CFrame.lookAt(targetHead.Position + Vector3.new(look.X, 0, look.Z).Unit * 1.1 + Vector3.new(0, 1.5, 0), targetHead.Position)
        elseif T.Propose and targetHead then
            local look = targetHead.CFrame.LookVector
            hrp.CFrame = CFrame.lookAt(targetHead.Position + Vector3.new(look.X, 0, look.Z).Unit * 3.5 + Vector3.new(0, 1.5, 0), targetHead.Position)
        elseif T.Bagpack and targetHRP then
            hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0.5, -1)
        elseif T.Goon and targetHead then
            local look = targetHead.CFrame.LookVector
            hrp.CFrame = CFrame.lookAt(targetHead.Position + Vector3.new(look.X, 0, look.Z).Unit * 4.5 + Vector3.new(0, 1.5, 0), targetHead.Position)
        elseif T.CustomAttach and targetHRP and T.CustomAttachEmoteId ~= "" then
            hrp.CFrame = targetHRP.CFrame * CFrame.new(T.CustomAttachOffsetX, T.CustomAttachOffsetY, T.CustomAttachOffsetZ)
        end
    end
end)

-- --------------------------------------------------
-- DRAGGING
-- --------------------------------------------------
local function makeDraggable(frame)
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, input.Position, frame.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end
makeDraggable(MainFrame)
makeDraggable(ToggleBtn)

