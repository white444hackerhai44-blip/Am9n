-- Facebang
local facebangSetupChar = nil
local facebangTrack = nil
local facebangOriginal = {}

local function fbCleanup()
    clearPhysicsRep()
    if facebangTrack then
        pcall(function() facebangTrack:Stop(0); facebangTrack:Destroy() end)
        facebangTrack = nil
    end
    if facebangSetupChar then
        for k, v in pairs(facebangOriginal) do
            if k and k.Parent then pcall(function() k.CanCollide = v.CanCollide end) end
        end
        facebangOriginal = {}
        local h = facebangSetupChar:FindFirstChildOfClass("Humanoid")
        if h then
            h.PlatformStand = false
            h.AutoRotate = true
            pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        local a = facebangSetupChar:FindFirstChild("Animate")
        if a then a.Disabled = false end
        pcall(function() Workspace.Gravity = 192.2 end)
        facebangSetupChar = nil
    end
end

local function fbSetup()
    local char = localPlayer.Character
    if not char then return false end
    if facebangSetupChar == char and facebangTrack and facebangTrack.IsPlaying then return true end
    fbCleanup()
    local h = char:FindFirstChildOfClass("Humanoid")
    if not h then return false end
    h.AutoRotate = false
    local animator = h:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = h
    end
    local animate = char:FindFirstChild("Animate")
    if animate and not animate.Disabled then animate.Disabled = true end
    for _, t in ipairs(animator:GetPlayingAnimationTracks() or {}) do pcall(function() t:Stop(0) end) end
    for _, t in ipairs(h:GetPlayingAnimationTracks() or {}) do pcall(function() t:Stop(0) end) end
    h.PlatformStand = true
    pcall(function() h:ChangeState(Enum.HumanoidStateType.Physics) end)
    pcall(function() Workspace.Gravity = 0 end)
    pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://116235062592344"
        facebangTrack = animator:LoadAnimation(anim)
        facebangTrack.Priority = Enum.AnimationPriority.Action4
        facebangTrack.Looped = true
        facebangTrack:Play()
    end)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            facebangOriginal[p] = { CanCollide = p.CanCollide }
            p.CanCollide = false
        end
    end
    facebangSetupChar = char
    return true
end

local function fbComputeCFrame(head)
    local speed = tonumber(FacebangSpeed) or 1
    local dist = tonumber(FacebangDistance) or 5
    local offset = 0.5 + ((math.sin(tick() * speed * 10) + 1) / 2) * dist
    local look = head.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    local unit = flat.Magnitude > 0 and flat.Unit or Vector3.new(0,0,1)
    local pos = head.Position
    local p2 = pos + unit * offset
    local v3 = Vector3.new(p2.X, pos.Y + 1.2, p2.Z)
    return CFrame.lookAt(v3, Vector3.new(pos.X, v3.Y, pos.Z))
end

local function fbApplyCFrame(useRep)
    if not (tbl.Facebang and humanoidRootPart) then return false end
    local tgt = FacebangTarget or pgPlayer
    if not (tgt and tgt.Character) then return false end
    local head = tgt.Character:FindFirstChild("Head")
    if not head then return false end
    local hrp = tgt.Character:FindFirstChild("HumanoidRootPart")
    local cf = fbComputeCFrame(head)
    if useRep and tbl.NoDelay and typeof(sethiddenproperty) == "function" and hrp then
        humanoidRootPart.CFrame = hrp.CFrame:ToObjectSpace(cf)
        humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
    else
        humanoidRootPart.CFrame = cf
        if hrp then
            humanoidRootPart.AssemblyLinearVelocity = hrp.AssemblyLinearVelocity
            humanoidRootPart.AssemblyAngularVelocity = hrp.AssemblyAngularVelocity
        else
            humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
        end
    end
    pcall(function() humanoidRootPart.Velocity = humanoidRootPart.AssemblyLinearVelocity end)
    pcall(function() humanoidRootPart.RotVelocity = Vector3.zero end)
    return true
end

local function fbActivate()
    if not fbSetup() then return end
    if FacebangTarget then
        local hrp = FacebangTarget.Character and FacebangTarget.Character:FindFirstChild("HumanoidRootPart")
        if tbl.NoDelay and hrp then setPhysicsRep(hrp) end
    end
end

