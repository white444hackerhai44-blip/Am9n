-- target validity check (exact from source)
local tbl18 = {}
local function isTargetValidAndAlive(model)
    if not model then return false end
    local character2 = model.Character
    if not character2 then
        character2 = typeof(model) == "Instance"
        if character2 then character2 = model:IsA("Model") end
        if character2 then character2 = model end
    end
    if character2 and character2.Parent then
        tbl18[model] = nil
        local humanoid2 = character2:FindFirstChildOfClass("Humanoid")
        if humanoid2 then
            if humanoid2.Health <= 0 then
                return false
            else
                local st = humanoid2:GetState()
                if st ~= Enum.HumanoidStateType.Dead then
                    local hrp = character2:FindFirstChild("HumanoidRootPart") or character2:FindFirstChild("Torso") or character2:FindFirstChild("Head")
                    if hrp and hrp.Parent then
                        local fh = workspace.FallenPartsDestroyHeight or -500
                        if typeof(fh) ~= "number" or fh ~= fh then fh = -500 end
                        local flag8 = hrp.AssemblyLinearVelocity.Y < -80
                        if flag8 then flag8 = hrp.Position.Y < fh + 30 end
                        if flag8 then return false end
                        return true
                    end
                    if typeof(character2.GetPivot) == "function" then
                        local ok, dead = pcall(function() return character2:GetPivot() end)
                        if ok and dead and dead.Position and dead.Position.Magnitude > 0.1 then
                            return true
                        end
                    end
                else
                    return false
                end
            end
        else
            local hrp = character2:FindFirstChild("HumanoidRootPart") or character2:FindFirstChild("Torso") or character2:FindFirstChild("Head")
            if hrp and hrp.Parent then
                local fh = workspace.FallenPartsDestroyHeight or -500
                if typeof(fh) ~= "number" or fh ~= fh then fh = -500 end
                local flag8 = hrp.AssemblyLinearVelocity.Y < -80
                if flag8 then flag8 = hrp.Position.Y < fh + 30 end
                if flag8 then return false end
                return true
            end
            if typeof(character2.GetPivot) == "function" then
                local ok, dead = pcall(function() return character2:GetPivot() end)
                if ok and dead and dead.Position and dead.Position.Magnitude > 0.1 then
                    return true
                end
            end
        end
        return false
    end
    local v6 = tbl18[model]
    if not v6 then
        tbl18[model] = tick()
        return true
    end
    if tick() - v6 < 3 then return true end
    return false
end

