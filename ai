            tween(knob, { BackgroundColor3 = Color3.fromRGB(100,100,100), Position = UDim2.new(0, 3, 0.5, -8) }, 0.25, Enum.EasingStyle.Back)
            tween(haloStroke, { Transparency = 1 }, 0.25)
        end
    end
    local function setState(v, silent)
        state = v
        tbl[key] = v
        render()
        if callback then callback(v) end
        if not silent then playClick() end
    end
    ToggleRegistry[key] = setState
    clickBtn.MouseButton1Click:Connect(function()
        setState(not state)
    end)
    local listening = false
    keyBtn.MouseButton1Click:Connect(function()
        listening = true
        keyBtn.Text = "..."
        playClick()
    end)
    UserInputService.InputBegan:Connect(function(input)
        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            local kc = input.KeyCode
            if kc ~= Enum.KeyCode.Escape then
                tbl2[bindKey] = kc
                keyBtn.Text = kc.Name
            else
                keyBtn.Text = tbl2[bindKey].Name
            end
            listening = false
        end
    end)
    render()
    return frame, setState, keyBtn
end

