-- EMOTE PLAYER (auto-resolves catalog ID → anim ID)
-- --------------------------------------------------
local EMOTE_ITEM_ID = 88553539939192
local currentEmoteTrack = nil

local function resolveAnimId(id)
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(id))
    end)
    if ok and objs and #objs > 0 then
        local obj = objs[1]
        if obj:IsA("Animation") and obj.AnimationId ~= "" then
            return tonumber(obj.AnimationId:match("%d+"))
        elseif obj:FindFirstChildOfClass("Animation") then
            local a = obj:FindFirstChildOfClass("Animation")
            return tonumber(a.AnimationId:match("%d+"))
        end
    end
    return nil
end

local EMOTE_ANIM_ID = resolveAnimId(EMOTE_ITEM_ID)
print("[EMOTE] Resolved animation ID:", EMOTE_ANIM_ID)

local EMOTE_ASSET = EMOTE_ANIM_ID and ("rbxassetid://" .. tostring(EMOTE_ANIM_ID)) or nil

local function stopEmote()
    if currentEmoteTrack then
        pcall(function() currentEmoteTrack:Stop() end)
        currentEmoteTrack = nil
    end
end

local function playEmote()
    if not EMOTE_ASSET then return end
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildWhichIsA("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildWhichIsA("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    stopEmote()
    local anim = Instance.new("Animation")
    anim.AnimationId = EMOTE_ASSET
    local ok, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)
    if not ok or not track then
        warn("[EMOTE] LoadAnimation failed for " .. EMOTE_ASSET)
        return
    end
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = true
    track:Play(0.1, 1, 1)
    currentEmoteTrack = track
end

